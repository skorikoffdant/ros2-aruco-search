<?xml version="1.0"?>
<package format="3">
  <name>aruco_search</name>
  <version>0.0.1</version>
  <description>ArUco cube localization with ROS 2 Action</description>
  <maintainer email="daniil.kavalevich@gmail.com">Daniil Kavalevich</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>aruco_search_interfaces</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
